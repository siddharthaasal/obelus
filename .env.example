# Copy to .env (make setup does this) and fill in GEMINI_API_KEY.
# Keep comments on their own lines: Make and some dotenv parsers mishandle inline ones.

GEMINI_API_KEY=

# Postgres runs in Docker on 5433 to avoid clashing with a local Postgres/Supabase on 5432.
# If you change POSTGRES_PORT, change the port in DATABASE_URL to match.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://obelus:obelus@127.0.0.1:5433/obelus

# Your library (library/) and database dumps (backups/). Lives outside the repo on purpose.
DATA_DIR=~/ObelusData

# No auth in the app: keep it on loopback and use `tailscale serve` for other devices.
APP_HOST=127.0.0.1
APP_PORT=8420

# Gemini models. Check the current Gemini docs and fill these in.
# MODEL_FAST: lookups (a Flash-class model). MODEL_DEEP: chat (a Pro-class model).
MODEL_FAST=
MODEL_DEEP=
EMBED_MODEL=
EMBED_DIM=768
CACHE_TTL_MINUTES=60
