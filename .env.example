# Copy to .env (make setup does this) and fill in GEMINI_API_KEY.
# Keep comments on their own lines: Make and some dotenv parsers mishandle inline ones.

GEMINI_API_KEY=

# Postgres runs in Docker on 5433 to avoid clashing with a local Postgres/Supabase on 5432.
# If you change POSTGRES_PORT, change the port in DATABASE_URL to match.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://obelus:obelus@127.0.0.1:5433/obelus

# Your library (library/) and database dumps (backups/). Lives outside the repo on purpose.
DATA_DIR=~/ObelusData

# No auth in the app: keep it on loopback and use `tailscale serve` for other devices.
APP_HOST=127.0.0.1
APP_PORT=8420

# Gemini models, set for a free API key. Flash-Lite has the most generous free quota (about
# 500 requests a day, against about 20 for the Flash models), and no Pro model is free.
# Check your actual limits at https://aistudio.google.com/rate-limit (they're per project).
# With a paid key, gemini-3.8-flash (lookups) and gemini-3.1-pro-preview (chat) are better,
# and a blank value means those defaults (see backend/app/config.py).
MODEL_FAST=gemini-3.5-flash-lite
MODEL_DEEP=gemini-3.5-flash-lite
# Embeddings aren't used until search arrives; that phase picks a model.
EMBED_MODEL=
EMBED_DIM=768
# Minutes an open book's Gemini cache lives (when CONTEXT_CACHING is on). It holds the book's
# text so each lookup doesn't pay for the whole book, and it's extended while you use it.
CACHE_TTL_MINUTES=60
# Thinking level for lookups: low, medium, or high. "default" leaves it to the model, which
# models without thinking levels (Gemini 2.5) need.
LOOKUP_THINKING=low
# Keep an open book in a Gemini context cache. The free tier doesn't include caching on
# Flash-Lite, so it's off and each lookup sends the book. Turn it on with a paid key.
CONTEXT_CACHING=false
# Most tokens of book text sent with one request; longer books send excerpts around the
# selection. Free keys cap tokens per minute; 100000 is about 300 pages. Blank or 0 means as
# much as the model's context window holds.
MAX_BOOK_TOKENS=100000
